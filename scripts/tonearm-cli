#!/usr/bin/env python3
"""tonearm — agent-friendly CLI for the tonearm music server.

Reads the API key from $TONEARM_KEY, then ~/.config/tonearm/opencode-key.txt,
then ~/.config/tonearm/master-key.txt. Server: $TONEARM_URL (default
http://127.0.0.1:8200).

Usage:
  tonearm np                 now playing (human readable; --json for raw)
  tonearm status             same as np
  tonearm play               ensure playback (play)
  tonearm pause | toggle | next | previous
  tonearm back [seconds]     restart if >N s (default 10) else previous
  tonearm play <query>       search the library and play the first song hit
  tonearm search <query>     show library matches (songs/artists/albums)
  tonearm queue              print the queue
  tonearm volume [N]         get volume, or set (absolute or +N/-N)
  tonearm shuffle on|off
  tonearm repeat off|all|one
  tonearm device [name]      device telemetry (default: tidbyt)
  tonearm health             server health (browser session state)
  tonearm url                the stream URL for this track position (PCM)
All commands accept --json for raw output.
"""

import json, os, sys, urllib.parse, urllib.request, urllib.error

BASE = os.environ.get("TONEARM_URL", "http://127.0.0.1:8200").rstrip("/")

def key():
    if os.environ.get("TONEARM_KEY"):
        return os.environ["TONEARM_KEY"].strip()
    for f in ("opencode-key.txt", "master-key.txt"):
        p = os.path.expanduser(f"~/.config/tonearm/{f}")
        if os.path.exists(p):
            k = open(p).read().strip()
            if k:
                return k
    sys.exit("tonearm: no API key (TONEARM_KEY or ~/.config/tonearm/opencode-key.txt)")

KEY = key()

def api(method, path, json_body=None):
    url = BASE + path
    data = json.dumps(json_body).encode() if json_body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {KEY}")
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            body = r.read().decode()
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read().decode()).get("detail", "")
        except Exception:
            detail = e.reason
        sys.exit(f"tonearm: HTTP {e.code} on {path}: {detail}")
    except urllib.error.URLError as e:
        sys.exit(f"tonearm: cannot reach server at {BASE}: {e.reason}")

def out(data, pretty):
    if pretty:
        print(json.dumps(data, indent=1))
    else:
        print(json.dumps(data))

def ms(msv):
    if not msv: return "0:00"
    s = int(msv) // 1000
    return f"{s//60}:{s%60:02d}"

def human_np(np):
    line1 = f"{np.get('title') or '(nothing playing)'}"
    if np.get("artist"):
        line1 += f" — {np['artist']}"
    if np.get("album"):
        line1 += f" [{np['album']}]"
    state = "playing" if np.get("isPlaying") else "paused"
    return (f"{line1}\n{state} · {ms(np.get('elapsedMs'))} / {ms(np.get('durationMs'))}"
            f" ({np.get('progress', 0)*100:.0f}%)")

def main():
    argv = [a for a in sys.argv[1:]]
    pretty = "--json" in argv
    argv = [a for a in argv if a != "--json"]
    if not argv:
        print(__doc__); sys.exit(1)
    cmd, rest = argv[0].lower(), argv[1:]

    if cmd in ("np", "status", "now-playing"):
        d = api("GET", "/api/playback/now-playing")
        out(d if pretty else d, pretty) if pretty else print(human_np(d))
    elif cmd in ("play", "pause", "toggle", "next", "previous", "prev"):
        if cmd == "prev": cmd = "previous"
        if cmd == "play" and rest:
            d = api("GET", f"/api/library/search?term={urllib.parse.quote(' '.join(rest))}&limit=10")
            songs = d.get("songs", [])
            if not songs:
                sys.exit("tonearm: no library match for " + " ".join(rest))
            s = songs[0]
            api("POST", f"/api/playback/play-song/{s['catalog_id'] or s['id']}")
            print(f"playing: {s['name']} — {s.get('artist','')} "
                  f"[{ms(s.get('duration_ms'))}]")
        else:
            api("POST", f"/api/playback/{cmd}")
            print(cmd)
    elif cmd == "back":
        th = int(float(rest[0]) * 1000) if rest else 10000
        api("POST", f"/api/playback/back?threshold_ms={th}")
        print("back")
    elif cmd == "search":
        if not rest: sys.exit("tonearm: search <query>")
        d = api("GET", f"/api/library/search?term={urllib.parse.quote(' '.join(rest))}&limit=10")
        if pretty: out(d, True); return
        for kind in ("songs", "artists", "albums"):
            for it in d.get(kind, []):
                extra = it.get("artist") or it.get("album") or ""
                print(f"[{kind[:-1]}] {it['name']}" +
                      (f" — {extra}" if extra else "") +
                      (f" ({ms(it.get('duration_ms'))})" if kind == "songs" else "") +
                      f"  id={it.get('catalog_id') or it.get('id')}")
    elif cmd == "queue":
        d = api("GET", "/api/playback/queue")
        out(d, pretty) if pretty else print(json.dumps(d, indent=1))
    elif cmd == "volume":
        if not rest:
            cur = api("GET", "/api/playback/volume").get("volume", 0)
            if pretty: out({"volume": cur}, True)
            else: print(f"volume: {round(cur*100)}%")
        else:
            v = rest[0]
            if v.startswith(("+", "-")):
                cur = api("GET", "/api/playback/volume").get("volume", 0.5)
                v = max(0.0, min(1.0, cur + int(v) / 100.0))
            else:
                v = max(0.0, min(1.0, float(v) / 100.0))
            api("POST", f"/api/playback/volume/{v}")
            print(f"volume: {round(v*100)}%")
    elif cmd == "shuffle":
        if not rest or rest[0].lower() not in ("on", "off"):
            sys.exit("tonearm: shuffle on|off")
        api("POST", f"/api/playback/shuffle/{rest[0].lower()}")
        print(f"shuffle {rest[0].lower()}")
    elif cmd == "repeat":
        m = {"off": 0, "all": 1, "one": 2}.get((rest[0].lower() if rest else ""))
        if m is None: sys.exit("tonearm: repeat off|all|one")
        api("POST", f"/api/playback/repeat/{m}")
        print(f"repeat {rest[0].lower()}")
    elif cmd == "device":
        d = api("GET", "/api/device/tidbyt/status")
        name = rest[0] if rest else None
        if name:
            d = (d.get("devices", {}).get(name)
                 or {"error": f"no report for {name}"})
            out(d, pretty) if pretty else print(json.dumps(d, indent=1))
        else:
            if pretty: out(d, True); return
            import time as _t
            for n, v in d.get("devices", {}).items():
                age = int(_t.time() - v.get("received_at", 0))
                print(f"{n}: v{v.get('version')} up {v.get('uptime_s')}s "
                      f"rssi {v.get('wifi_rssi')} last report {age}s ago")
            for sid, v in d.get("opencode", {}).items():
                print(f"oc {sid[:18]}: {v.get('state')} {v.get('project')} "
                      f"/ {v.get('activity')}")
    elif cmd == "health":
        out(api("GET", "/health"), pretty) if pretty else \
            print(json.dumps(api("GET", "/health"), indent=1))
    elif cmd == "capture":
        if not rest: sys.exit("tonearm: capture SECONDS [out.wav]")
        secs = int(rest[0])
        out_path = rest[1] if len(rest) > 1 else f"/tmp/tonearm-capture.wav"
        import struct, wave, subprocess
        rate, ch, width = 44100, 2, 2
        raw = subprocess.run(
            ["curl", "-sS", "-N", "-m", str(secs + 2),
             f"{BASE}/api/audio/stream.pcm?api_key={KEY}"],
            capture_output=True, timeout=secs + 15).stdout
        bytes_want = secs * rate * ch * width
        raw = raw[:bytes_want]
        with wave.open(out_path, "wb") as w:
            w.setnchannels(ch); w.setsampwidth(width); w.setframerate(rate)
            w.writeframes(raw)
        print(f"{out_path} ({secs}s, {len(raw)/1e6:.1f} MB)")
    elif cmd == "url":
        print(f"{BASE}/api/audio/stream.pcm?api_key={KEY}")
    else:
        print(__doc__); sys.exit(1)

if __name__ == "__main__":
    main()
